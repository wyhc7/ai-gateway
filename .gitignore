# dependencies
node_modules/

# build output
dist/

# runtime data（含网关 Key 与平台 API Key，勿提交）
server/data/
# 部署脚本把 DATA_DIR 放在仓库根（/opt/ai-gateway/data），同样不能提交
/data/

# logs & env
*.log
.env
.env.local
.env.*.local
.DS_Store

# auto-generated by unplugin-auto-import / unplugin-vue-components
web/auto-imports.d.ts
web/components.d.ts

# 本地运维/测试脚本（含生产服务器地址、本机路径与密钥，勿提交）
_deploy.py
_test_oauth.mjs
_*.py
_*.mjs
start-*.bat
start-*.sh

out/

# 临时命令脚本
.tmp_*
*.tmp.sh
.t.sh

# SSH / 凭据 helper —— 这些文件里是**明文密码**，一旦提交就是事故。
# 历史事故：.sshpass.bat、.sshlogin.bat 都曾被 git add -A 带进去过，
# 所以这里不按具体名字拦，凡是名字里带 pass/login/cred/secret/keepass
# 的 dotfile 一律挡掉。
*pass*.bat
*login*.bat
*login*.txt
*cred*
*secret*
.sshask*
.keepass*

# 例外：扫描器本身的名字里带 secret，但它必须进仓库才有意义
!scripts/check-secrets.mjs
