# dependencies
node_modules/

# build output
dist/

# runtime data（含网关 Key 与平台 API Key，勿提交）
server/data/
# 部署脚本把 DATA_DIR 放在仓库根（/opt/ai-gateway/data），同样不能提交
/data/

# logs & env
*.log
.env
.env.local
.env.*.local
.DS_Store

# auto-generated by unplugin-auto-import / unplugin-vue-components
web/auto-imports.d.ts
web/components.d.ts

# 本地运维/测试脚本（含生产服务器地址、本机路径与密钥，勿提交）
_deploy.py
_test_oauth.mjs
_*.py
_*.mjs
start-*.bat
start-*.sh

out/

# 临时命令脚本
.tmp_*
*.tmp.sh
.t.sh

# SSH / 凭据 helper —— 这些文件里是**明文密码**，一旦提交就是事故。
# 历史事故：.sshpass.bat、.sshlogin.bat 都曾被 git add -A 带进去过。
*pass*.bat
*login*.bat
*login*.txt
# 凭据文件按「扩展名 + 名字形态」拦，不要用 *cred* / *secret* 这种裸通配。
# 历史事故：*cred* 把 web/src/components/CreditsPanel.vue 吃掉了 ——
# git add -A 之后 git status 里找不到这个文件，diff 也没有，只有翻 .gitignore
# 才发现。源码文件名带 cred/secret 是完全正常的命名，不该因为起名被挡在仓库外。
*.cred
.cred*
*cred*.json
*cred*.txt
*cred*.pem
*cred*.key
.secret*
*secret*.json
*secret*.txt
*secret*.pem
*secret*.key
.sshask*
.keepass*

# 例外：扫描器本身必须进仓库才有意义
!scripts/check-secrets.mjs

# WorkBuddy / CodeBuddy 登录态导出文件 —— 里面是活的 accessToken / refreshToken，
# 提交上去等于把账号送人。导入用的样本文件一律不进仓库。
workbuddy-*.json
workbuddy-accounts-*.json
